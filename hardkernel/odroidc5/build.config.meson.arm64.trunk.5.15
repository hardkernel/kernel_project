	amlogic-clk-soc-* 1 amlogic-clk-soc-s7d.ko
	amlogic-pinctrl-soc-* 1 amlogic-pinctrl-soc-s7d.ko
	amlogic-snd-codec-* 2 amlogic-snd-codec-dummy.ko amlogic-snd-codec-t9015.ko
"

