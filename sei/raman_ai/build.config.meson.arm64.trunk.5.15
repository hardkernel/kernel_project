KERNEL_DEVICETREE="s6_s905x5_raman_ai"

GLOBAL_VARIABLE_VALUE="
	GPU_DRV_VERSION=r44p1
	GPU_TYPE=vale
"

EXT_MODULES_ANDROID="
	//driver_modules/gpu/valhall:gpu
	//driver_modules/media_modules:media
	//driver_modules/DTVKit/AFD:afd
	//driver_modules/wifi_bt/wifi:wlan
	//driver_modules/wifi_bt/bt:bt
	//driver_modules/adla/driver:adla
	//driver_modules/camera/csi_cam/driver:csi_camera
"

EXT_MODULES_ANDROID_AUTO_LOAD="
"

KCONFIG_EXT_ANDROID="
"

WIFI_FW=$(cat driver_modules/wifi_bt/wifi/configs/wifi_fw_list.txt)

FIRMWARES_COPY_FROM_TO="
	driver_modules/media_modules/firmware:video
	${WIFI_FW}
"

TYPE_MODULE_SELECT_MODULE_ANDROID="
	amlogic-clk-soc-* 1 amlogic-clk-soc-s6.ko
	amlogic-pinctrl-soc-* 1 amlogic-pinctrl-soc-s6.ko
	amlogic-snd-codec-* 4 amlogic-snd-codec-dummy.ko amlogic-snd-codec-ntp8918.ko amlogic-snd-codec-tas5707.ko amlogic-snd-codec-tl1.ko
"

MODULES_OUT_REMOVE="
"

MODULES_OUT_ADD="
	common_drivers/drivers/amfc/amlogic-amfc.ko
	common_drivers/drivers/amfc/aml_erofs/aml-erofs.ko
	common_drivers/drivers/external/st7789v3_tft/st7789v3_tft.ko
	common_drivers/sound/soc/codecs/amlogic/amlogic-snd-codec-ntp8918.ko
"

MODULES_LOAD_BLACK_LIST="
	amlogic_pcie_v2_host.ko
"

MODULES_SERVICE_LOAD_LIST="
"

EXTRA_GKI_MODULES_LIST="
	cdc-acm.ko
"

MODULES_SEQUENCE_LIST=

DEV_CONFIGS="
	raman_u_common14-5.15_devconfig
	raman_ai_u_common14-5.15_devconfig
"

GKI_CONFIG=gki_20

ANDROID_OUT_DIR="device/sei/raman_ai-kernel/5.15"
